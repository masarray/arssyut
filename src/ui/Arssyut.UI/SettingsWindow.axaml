<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Arssyut.UI.SettingsWindow"
    Title="Arssyut Settings"
    Width="760"
    Height="520"
    MinWidth="720"
    MinHeight="480"
    CanResize="False"
    WindowDecorations="None"
    Background="Transparent"
    FontFamily="{DynamicResource ArFont.Inter}"
    TextOptions.TextRenderingMode="SubpixelAntialias">

  <Border
      Margin="1"
      Background="#F00B0E12"
      BorderBrush="{DynamicResource ArBrush.StrokeStrong}"
      BorderThickness="1"
      CornerRadius="12"
      ClipToBounds="True">

    <Grid RowDefinitions="44,*">

      <Grid
          Grid.Row="0"
          Margin="14,0,10,0"
          ColumnDefinitions="*,Auto"
          PointerPressed="TitleBar_OnPointerPressed">
        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">
          <LucideIcon
              Kind="Settings2"
              Size="15"
              StrokeWidth="1.8"
              Foreground="{DynamicResource ArBrush.TextSecondary}" />
          <TextBlock
              Text="Settings"
              FontSize="12.5"
              FontWeight="SemiBold" />
        </StackPanel>

        <Button
            Grid.Column="1"
            Classes="window-control danger"
            Click="Close_OnClick">
          <LucideIcon
              Kind="X"
              Size="15"
              StrokeWidth="1.8"
              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
      </Grid>

      <Grid
          Grid.Row="1"
          ColumnDefinitions="174,*"
          Margin="10,4,10,10">

        <!-- Navigation -->
        <Border
            Classes="subtle-panel"
            Background="#76161B23"
            Padding="8">
          <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock
                Text="Preferences"
                Classes="micro"
                FontWeight="SemiBold"
                Margin="10,6,0,9" />

            <StackPanel
                Grid.Row="1"
                Spacing="3">
              <Button x:Name="NavGeneral" Classes="nav" Click="Nav_OnClick" Tag="General">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <LucideIcon Kind="Settings2" Size="15" StrokeWidth="1.8"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock Text="General" />
                </StackPanel>
              </Button>

              <Button x:Name="NavRecording" Classes="nav selected" Click="Nav_OnClick" Tag="Recording">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <LucideIcon Kind="Video" Size="15" StrokeWidth="1.8"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock Text="Recording" />
                </StackPanel>
              </Button>

              <Button x:Name="NavOutput" Classes="nav" Click="Nav_OnClick" Tag="Output">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <LucideIcon Kind="FolderOpen" Size="15" StrokeWidth="1.8"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock Text="Output" />
                </StackPanel>
              </Button>

              <Button x:Name="NavAudio" Classes="nav" Click="Nav_OnClick" Tag="Audio">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <LucideIcon Kind="Volume2" Size="15" StrokeWidth="1.8"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock Text="Audio" />
                </StackPanel>
              </Button>

              <Button x:Name="NavCamera" Classes="nav" Click="Nav_OnClick" Tag="Camera">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <LucideIcon Kind="Camera" Size="15" StrokeWidth="1.8"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock Text="Camera" />
                </StackPanel>
              </Button>

              <Button x:Name="NavMouse" Classes="nav" Click="Nav_OnClick" Tag="Mouse">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <LucideIcon Kind="MousePointer2" Size="15" StrokeWidth="1.8"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock Text="Mouse & Keys" />
                </StackPanel>
              </Button>

              <Button x:Name="NavHotkeys" Classes="nav" Click="Nav_OnClick" Tag="Hotkeys">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <LucideIcon Kind="Keyboard" Size="15" StrokeWidth="1.8"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock Text="Hotkeys" />
                </StackPanel>
              </Button>

              <Button x:Name="NavAdvanced" Classes="nav" Click="Nav_OnClick" Tag="Advanced">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <LucideIcon Kind="Wrench" Size="15" StrokeWidth="1.8"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock Text="Advanced" />
                </StackPanel>
              </Button>
            </StackPanel>

            <TextBlock
                Grid.Row="2"
                Text="P6UI visual preview"
                Classes="micro"
                Margin="10,10,0,4" />
          </Grid>
        </Border>

        <!-- Content -->
        <Border
            Grid.Column="1"
            Margin="10,0,0,0"
            Padding="20,16"
            Background="#5C10141A"
            CornerRadius="10">
          <Grid RowDefinitions="Auto,*">

            <StackPanel Spacing="3">
              <TextBlock
                  x:Name="PageTitle"
                  Text="Recording"
                  Classes="title" />
              <TextBlock
                  x:Name="PageSubtitle"
                  Text="Quality, visual presentation, and recording behavior."
                  Classes="micro" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                Margin="0,14,0,0"
                VerticalScrollBarVisibility="Auto">

              <Grid>

                <!-- General -->
                <StackPanel x:Name="PageGeneral" IsVisible="False">
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Show countdown" FontWeight="Medium" />
                        <TextBlock Text="Give a short visual countdown before recording begins." Classes="micro" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="ar-toggle" IsChecked="True" OnContent="" OffContent="" />
                    </Grid>
                  </Border>
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Hide main window while recording" FontWeight="Medium" />
                        <TextBlock Text="Keep only the floating recording controller visible." Classes="micro" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="ar-toggle" IsChecked="True" OnContent="" OffContent="" />
                    </Grid>
                  </Border>
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Show recording boundary" FontWeight="Medium" />
                        <TextBlock Text="Display the actual capture viewport outside the encoded frame." Classes="micro" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="ar-toggle" IsChecked="True" OnContent="" OffContent="" />
                    </Grid>
                  </Border>
                </StackPanel>

                <!-- Recording -->
                <StackPanel x:Name="PageRecording">
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,180">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Frame rate" FontWeight="Medium" />
                        <TextBlock Text="Output cadence used by the recorder." Classes="micro" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Classes="ar-select" SelectedIndex="1">
                        <ComboBoxItem Content="30 fps" />
                        <ComboBoxItem Content="60 fps" />
                      </ComboBox>
                    </Grid>
                  </Border>

                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,180">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Visual style" FontWeight="Medium" />
                        <TextBlock Text="Presentation-grade post processing without changing capture geometry." Classes="micro" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Classes="ar-select" SelectedIndex="0">
                        <ComboBoxItem Content="Pixel Accurate" />
                        <ComboBoxItem Content="Clean Screen" />
                        <ComboBoxItem Content="Vivid Presentation" />
                      </ComboBox>
                    </Grid>
                  </Border>

                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Smart Zoom" FontWeight="Medium" />
                        <TextBlock Text="Let ArZoom follow pointer intent while preserving a stable viewport." Classes="micro" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="ar-toggle" IsChecked="True" OnContent="" OffContent="" />
                    </Grid>
                  </Border>

                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,180">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Recording controller" FontWeight="Medium" />
                        <TextBlock Text="Compact controller shown while the main window is hidden." Classes="micro" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Classes="ar-select" SelectedIndex="0">
                        <ComboBoxItem Content="Floating bar" />
                        <ComboBoxItem Content="Hidden" />
                      </ComboBox>
                    </Grid>
                  </Border>
                </StackPanel>

                <!-- Output -->
                <StackPanel x:Name="PageOutput" IsVisible="False">
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Output folder" FontWeight="Medium" />
                        <TextBlock Text="Videos\Arssyut" Classes="micro" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ar">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <LucideIcon Kind="FolderOpen" Size="15" StrokeWidth="1.8"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                          <TextBlock Text="Browse" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,180">
                      <StackPanel Spacing="3">
                        <TextBlock Text="File naming" FontWeight="Medium" />
                        <TextBlock Text="Compact timestamped names that stay sortable." Classes="micro" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Classes="ar-select" SelectedIndex="0">
                        <ComboBoxItem Content="Date + time" />
                        <ComboBoxItem Content="Application + time" />
                      </ComboBox>
                    </Grid>
                  </Border>
                </StackPanel>

                <!-- Audio -->
                <StackPanel x:Name="PageAudio" IsVisible="False">
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="System audio" FontWeight="Medium" />
                        <TextBlock Text="Desktop playback captured through WASAPI loopback." Classes="micro" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="ar-toggle" IsChecked="True" OnContent="" OffContent="" />
                    </Grid>
                  </Border>
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,220">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Microphone device" FontWeight="Medium" />
                        <TextBlock Text="Narration input used by the recorder." Classes="micro" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Classes="ar-select" SelectedIndex="0">
                        <ComboBoxItem Content="Hi-Fi Cable Output (VB-Audio)" />
                        <ComboBoxItem Content="Default microphone" />
                      </ComboBox>
                    </Grid>
                  </Border>
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Microphone" FontWeight="Medium" />
                        <TextBlock Text="Include narration in the recorded session." Classes="micro" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="ar-toggle" IsChecked="True" OnContent="" OffContent="" />
                    </Grid>
                  </Border>
                </StackPanel>

                <!-- Camera -->
                <StackPanel x:Name="PageCamera" IsVisible="False">
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,220">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Camera device" FontWeight="Medium" />
                        <TextBlock Text="Picture-in-picture source." Classes="micro" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Classes="ar-select" SelectedIndex="0">
                        <ComboBoxItem Content="USB2.0 HD UVC Webcam" />
                      </ComboBox>
                    </Grid>
                  </Border>
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,180">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Placement" FontWeight="Medium" />
                        <TextBlock Text="Default webcam anchor in the recorded frame." Classes="micro" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Classes="ar-select" SelectedIndex="0">
                        <ComboBoxItem Content="Bottom right" />
                        <ComboBoxItem Content="Bottom left" />
                        <ComboBoxItem Content="Top right" />
                      </ComboBox>
                    </Grid>
                  </Border>
                </StackPanel>

                <!-- Mouse -->
                <StackPanel x:Name="PageMouse" IsVisible="False">
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Click highlight" FontWeight="Medium" />
                        <TextBlock Text="Render a compact pointer click visualization." Classes="micro" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="ar-toggle" IsChecked="True" OnContent="" OffContent="" />
                    </Grid>
                  </Border>
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Shortcut keys" FontWeight="Medium" />
                        <TextBlock Text="Show canonical keycaps for selected keyboard shortcuts." Classes="micro" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="ar-toggle" IsChecked="True" OnContent="" OffContent="" />
                    </Grid>
                  </Border>
                </StackPanel>

                <!-- Hotkeys -->
                <StackPanel x:Name="PageHotkeys" IsVisible="False">
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,150">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Record / Stop" FontWeight="Medium" />
                        <TextBlock Text="Global recorder transport shortcut." Classes="micro" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="subtle-panel" Padding="10,7">
                        <TextBlock Text="F9" HorizontalAlignment="Center" FontFeatures="+tnum" />
                      </Border>
                    </Grid>
                  </Border>
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,150">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Pause / Resume" FontWeight="Medium" />
                        <TextBlock Text="Available after the native pause state lands." Classes="micro" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="subtle-panel" Padding="10,7">
                        <TextBlock Text="F10" HorizontalAlignment="Center" FontFeatures="+tnum" />
                      </Border>
                    </Grid>
                  </Border>
                </StackPanel>

                <!-- Advanced -->
                <StackPanel x:Name="PageAdvanced" IsVisible="False">
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Diagnostics sidecar" FontWeight="Medium" />
                        <TextBlock Text="Keep bounded session diagnostics beside the recording." Classes="micro" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="ar-toggle" IsChecked="True" OnContent="" OffContent="" />
                    </Grid>
                  </Border>
                  <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Reset UI preview" FontWeight="Medium" />
                        <TextBlock Text="Restores design-preview values only." Classes="micro" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ar" Content="Reset" />
                    </Grid>
                  </Border>
                </StackPanel>

              </Grid>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
