<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Arssyut.UI.MainWindow"
    Title="Arssyut"
    Width="1000"
    Height="334"
    MinWidth="920"
    MinHeight="318"
    CanResize="False"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None"
    Background="Transparent"
    FontFamily="{DynamicResource ArFont.Inter}"
    TextOptions.TextRenderingMode="SubpixelAntialias"
    KeyDown="Window_OnKeyDown">

  <Border
      Margin="1"
      Background="{DynamicResource ArBrush.WindowChromeMain}"
      BorderBrush="{DynamicResource ArBrush.StrokeStrong}"
      BorderThickness="1"
      CornerRadius="12"
      ClipToBounds="True">

    <Grid RowDefinitions="46,*">

      <!-- Entire empty title-bar surface must remain draggable. -->
      <Grid
          x:Name="TitleBar"
          Grid.Row="0"
          ColumnDefinitions="*,Auto"
          Margin="14,0,8,0"
          Background="Transparent"
          PointerPressed="TitleBar_OnPointerPressed">

        <StackPanel
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Spacing="9">
          <Border
              Width="22"
              Height="22"
              CornerRadius="7"
              Background="{DynamicResource ArBrush.Selection}"
              BorderBrush="{DynamicResource ArBrush.RecordStroke}"
              BorderThickness="1">
            <LucideIcon
                Kind="Video"
                Size="13"
                StrokeWidth="1.9"
                Foreground="{DynamicResource ArBrush.Record}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
          </Border>

          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock
                Text="Arssyut"
                FontSize="13"
                FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Spacing="3">
          <Button
              Classes="ar"
              Height="30"
              Padding="10,0"
              Click="Settings_OnClick"
              AutomationProperties.Name="Open Settings"
              ToolTip.Tip="Settings">
            <StackPanel
                Orientation="Horizontal"
                Spacing="7"
                VerticalAlignment="Center">
              <LucideIcon
                  Kind="Settings2"
                  Size="15"
                  StrokeWidth="1.8"
                  VerticalAlignment="Center"
                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              <TextBlock
                  Text="Settings"
                  FontSize="11.5"
                  VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button
              Classes="window-control"
              Click="Minimize_OnClick"
              AutomationProperties.Name="Minimize Arssyut"
              ToolTip.Tip="Minimize">
            <LucideIcon
                Kind="Minus"
                Size="15"
                StrokeWidth="1.8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>

          <Button
              Classes="window-control danger"
              Click="Close_OnClick"
              AutomationProperties.Name="Close Arssyut"
              ToolTip.Tip="Close">
            <LucideIcon
                Kind="X"
                Size="15"
                StrokeWidth="1.8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid
          Grid.Row="1"
          RowDefinitions="*,Auto"
          RowSpacing="10"
          Margin="18,8,18,14">

        <!-- Context workspace -->
        <Grid Grid.Row="0"
              ColumnDefinitions="2.00*,1.70*,1.05*,0.95*"
              ColumnSpacing="10">

          <Border Classes="context-card">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <LucideIcon Kind="ScanLine" Size="14" StrokeWidth="1.8"
                              Foreground="{DynamicResource ArBrush.TextSecondary}" />
                  <TextBlock Text="Capture" Classes="context-title" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Classes="icon"
                        Click="RefreshSources_OnClick"
                        AutomationProperties.Name="Refresh capture sources"
                        ToolTip.Tip="Refresh sources">
                  <LucideIcon Kind="RefreshCw" Size="14" StrokeWidth="1.8"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
              </Grid>

              <Grid Grid.Row="1" VerticalAlignment="Center"
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="6">
                <ToggleButton x:Name="ModeDisplay"
                              Grid.Column="0"
                              Classes="capture-mode"
                              Tag="Display"
                              IsChecked="True"
                              Click="CaptureMode_OnClick"
                              AutomationProperties.Name="Capture Display">
                  <StackPanel Orientation="Vertical" Spacing="3"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="23" Height="24" Stretch="Uniform"><Canvas Width="512" Height="512">
                      <Path Data="M488.188,41.797H23.813C10.719,41.797,0,52.516,0,65.609v311.969c0,13.094,10.719,23.813,23.813,23.813 h152.375v46.016h-31.031v22.797h221.688v-22.797h-31.031v-46.016h152.375c13.094,0,23.813-10.719,23.813-23.813V65.609 C512,52.516,501.281,41.797,488.188,41.797z M481.031,360.922H30.953V72.766h450.078V360.922z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </Canvas></Viewbox>
                    <TextBlock Text="Display" FontSize="10.5"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                  </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="ModeWindow"
                              Grid.Column="1"
                              Classes="capture-mode"
                              Tag="Window"
                              Click="CaptureMode_OnClick"
                              AutomationProperties.Name="Capture Window">
                  <StackPanel Orientation="Vertical" Spacing="3"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="24" Height="24" Stretch="Uniform"><Canvas Width="512" Height="512">
                      <Path Data="M462.387,0H49.612C23.31,0,1.985,21.325,1.985,47.628v349.271c0,26.302,21.325,47.628,47.628,47.628h247.14 l-4.116-39.69H49.612c-4.38,0-7.938-3.566-7.938-7.938V103.194h428.651v293.706c0,4.372-3.558,7.938-7.938,7.938h-24.527 l26.333,39.597c25.458-0.954,45.822-21.846,45.822-47.535V47.628C510.015,21.325,488.69,0,462.387,0z M303.295,72.434 c-10.411,0-18.853-8.442-18.853-18.853c0-10.41,8.442-18.852,18.853-18.852c10.41,0,18.852,8.442,18.852,18.852 C322.147,63.992,313.705,72.434,303.295,72.434z M373.248,72.434c-10.41,0-18.853-8.442-18.853-18.853 c0-10.41,8.442-18.852,18.853-18.852c10.411,0,18.853,8.442,18.853,18.852C392.101,63.992,383.659,72.434,373.248,72.434z M443.201,72.434c-10.411,0-18.853-8.442-18.853-18.853c0-10.41,8.442-18.852,18.853-18.852c10.411,0,18.853,8.442,18.853,18.852 C462.054,63.992,453.612,72.434,443.201,72.434z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                      <Path Data="M113.116,174.636 h285.768 v31.752 h-285.768 z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                      <Path Data="M113.116,238.14 h285.768 v31.752 h-285.768 z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                      <Path Data="M113.116,301.644 h150.822 v31.752 h-150.822 z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                      <Path Data="M444.558,379.387 L315.535,305.612 L331.232,461.675 L361.512,425.038 L418.729,512 L461.581,483.799 L404.372,396.837 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </Canvas></Viewbox>
                    <TextBlock Text="Window" FontSize="10.5"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                  </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="ModeRegion"
                              Grid.Column="2"
                              Classes="capture-mode"
                              Tag="Region"
                              Click="CaptureMode_OnClick"
                              AutomationProperties.Name="Capture Region">
                  <StackPanel Orientation="Vertical" Spacing="3"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="24" Height="24" Stretch="Uniform"><Canvas Width="24" Height="24">
                      <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                      <Path Data="M21,9V4a1,1,0,0,0-1-1H15 M15,21h5a1,1,0,0,0,1-1V15 M9,3H4A1,1,0,0,0,3,4V9 M3,15v5a1,1,0,0,0,1,1H9"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" />
                    </Canvas></Viewbox>
                    <TextBlock Text="Region" FontSize="10.5"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                  </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="ModeGame"
                              Grid.Column="3"
                              Classes="capture-mode"
                              Tag="Game"
                              IsEnabled="False"
                              ToolTip.Tip="Game capture backend is pending."
                              AutomationProperties.Name="Game capture pending">
                  <StackPanel Orientation="Vertical" Spacing="3"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="27" Height="24" Stretch="Uniform"><Canvas Width="512" Height="512">
                      <Path Data="M510.002,309.835l-0.068-0.326l-0.076-0.334l-26.508-112.721l-0.106-0.417l-0.106-0.418 c-16.668-62.217-73.294-105.666-137.712-105.666H166.579c-64.418,0-121.045,43.449-137.712,105.666l-0.114,0.418l-0.099,0.417 L2.147,309.174l-0.076,0.326l-0.068,0.326c-9.749,46.43,16.926,92.496,62.036,107.168l1.586,0.509 c9.24,3.012,18.89,4.544,28.624,4.544c32.668,0,63.128-17.404,79.758-45.489l22.556-33.343l0.561-0.835l0.509-0.872 c0.796-1.388,2.276-2.253,3.861-2.253h109.02c1.586,0,3.066,0.865,3.862,2.253l0.508,0.872l0.562,0.835l22.555,33.343 c16.63,28.085,47.09,45.489,79.766,45.489c9.734,0,19.384-1.532,28.67-4.56l1.533-0.493 C493.07,402.331,519.737,356.257,510.002,309.835z M439.318,390.397l-1.54,0.501c-6.608,2.154-13.353,3.186-20.014,3.186 c-22.646,0-44.283-11.949-56.088-32.433l-23.064-34.101c-5.788-10.053-16.508-16.258-28.101-16.258h-109.02 c-11.592,0-22.312,6.206-28.101,16.258l-23.063,34.101c-11.804,20.484-33.434,32.433-56.081,32.433 c-6.661,0-13.405-1.032-20.013-3.186l-1.548-0.501c-31.431-10.219-50.102-42.485-43.311-74.819l26.508-112.722 c13.42-50.102,58.826-84.94,110.696-84.94h178.847c51.869,0,97.276,34.838,110.696,84.94l26.508,112.722 C489.413,347.912,470.75,380.178,439.318,390.397z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                      <Path Data="M157.453,172.061 L123.912,172.061 L123.912,210.579 L85.387,210.579 L85.387,244.105 L123.912,244.105 L123.912,282.637 L157.453,282.637 L157.453,244.105 L195.978,244.105 L195.978,210.579 L157.453,210.579 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                      <Path Data="M365.721,206.247c11.668,0,21.113-9.445,21.113-21.098c0-11.669-9.445-21.114-21.113-21.114 c-11.653,0-21.098,9.445-21.098,21.114C344.622,196.802,354.068,206.247,365.721,206.247z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                      <Path Data="M323.509,206.247c-11.653,0-21.106,9.453-21.106,21.098c0,11.669,9.453,21.122,21.106,21.122 c11.661,0,21.106-9.453,21.106-21.122C344.615,215.7,335.17,206.247,323.509,206.247z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                      <Path Data="M365.721,248.459c-11.653,0-21.098,9.445-21.098,21.114c0,11.653,9.445,21.098,21.098,21.098 c11.668,0,21.113-9.445,21.113-21.098C386.834,257.904,377.388,248.459,365.721,248.459z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                      <Path Data="M407.933,206.247c-11.653,0-21.099,9.453-21.099,21.098c0,11.669,9.446,21.122,21.099,21.122 c11.66,0,21.113-9.453,21.113-21.122C429.046,215.7,419.593,206.247,407.933,206.247z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </Canvas></Viewbox>
                    <TextBlock Text="Game" FontSize="10.5"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                  </StackPanel>
                </ToggleButton>
              </Grid>

              <Button x:Name="SourcePickerButton"
                      Grid.Row="2"
                      VerticalAlignment="Bottom"
                      Classes="source-picker"
                      AutomationProperties.Name="Choose capture source"
                      AutomationProperties.HelpText="Opens native sources for the selected capture mode.">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Border Width="30" Height="30" CornerRadius="8"
                          Background="{DynamicResource ArBrush.Surface3}">
                    <LucideIcon x:Name="SourceIcon" Kind="Monitor"
                                Size="15" StrokeWidth="1.8"
                                Foreground="{DynamicResource ArBrush.TextSecondary}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SourceTitle"
                               Text="Display 1"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SourceSubtitle"
                               Text="1920 × 1080 · Primary"
                               Classes="micro"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <LucideIcon Grid.Column="2"
                              Kind="ChevronDown"
                              Size="15"
                              StrokeWidth="1.8"
                              Foreground="{DynamicResource ArBrush.TextDim}"
                              VerticalAlignment="Center" />
                </Grid>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft"
                          FlyoutPresenterClasses="device-flyout">
                    <StackPanel Width="430" Spacing="5">
                      <Grid Margin="8,5,8,4" ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock x:Name="SourceFlyoutTitle"
                                     Text="Displays"
                                     FontWeight="SemiBold" />
                          <TextBlock x:Name="SourceFlyoutSubtitle"
                                     Text="Choose the capture target"
                                     Classes="micro" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="8,4"
                                CornerRadius="99"
                                Background="{DynamicResource ArBrush.Surface3}">
                          <TextBlock x:Name="SourceCountText"
                                     Text="0 sources"
                                     FontSize="9.5"
                                     Foreground="{DynamicResource ArBrush.TextSecondary}" />
                        </Border>
                      </Grid>
                      <StackPanel x:Name="SourceListPanel" Spacing="3" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Border>

          <Border Grid.Column="1" Classes="context-card">
            <Grid RowDefinitions="Auto,*,*" RowSpacing="8">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <LucideIcon Kind="Volume2" Size="14" StrokeWidth="1.8"
                            Foreground="{DynamicResource ArBrush.TextSecondary}" />
                <TextBlock Text="Audio" Classes="context-title" />
              </StackPanel>

              <!-- Each meter occupies the right side of its source from switch
                   to device selector, never another row below the selector. -->
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto" ColumnSpacing="9" RowSpacing="6"
                    VerticalAlignment="Center">
                <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                  <Border Width="27" Height="27" CornerRadius="8"
                          Background="{DynamicResource ArBrush.Surface3}">
                    <LucideIcon Kind="Volume2" Size="14" StrokeWidth="1.8"
                                Foreground="{DynamicResource ArBrush.TextSecondary}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="System audio" FontWeight="SemiBold"
                             FontSize="10.8" VerticalAlignment="Center" />
                  <ToggleSwitch x:Name="SystemAudioToggle"
                                Grid.Column="2" Classes="context-toggle ar-toggle"
                                Click="SystemAudioToggle_OnClick"
                                IsChecked="False" IsEnabled="False"
                                OnContent="" OffContent=""
                                ToolTip.Tip="System audio recording is unavailable in this build." />
                </Grid>
                <Border x:Name="SystemAudioDeviceComboMain" Grid.Row="1" Grid.Column="0"
                        Padding="8,7" CornerRadius="7"
                        Background="{DynamicResource ArBrush.Surface3}"
                        ToolTip.Tip="Captures the Windows default playback endpoint.">
                  <TextBlock Text="Windows default playback" FontSize="10.5"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource ArBrush.TextSecondary}"/>
                </Border>
                <StackPanel Grid.Column="1" Grid.RowSpan="2"
                            Orientation="Horizontal" Spacing="5"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip.Tip="Live input peak L/R (60 dB range).">
                  <StackPanel Spacing="3" HorizontalAlignment="Center">
                    <Border Width="8" Height="55" CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource ArBrush.Surface3}">
                      <Border x:Name="SystemLevelL" Height="0" VerticalAlignment="Bottom"
                              CornerRadius="4" Background="{DynamicResource ArBrush.Success}" />
                    </Border>
                    <TextBlock Text="L" FontSize="9" HorizontalAlignment="Center"
                               Foreground="{DynamicResource ArBrush.TextSecondary}" />
                  </StackPanel>
                  <StackPanel Spacing="3" HorizontalAlignment="Center">
                    <Border Width="8" Height="55" CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource ArBrush.Surface3}">
                      <Border x:Name="SystemLevelR" Height="0" VerticalAlignment="Bottom"
                              CornerRadius="4" Background="{DynamicResource ArBrush.Success}" />
                    </Border>
                    <TextBlock Text="R" FontSize="9" HorizontalAlignment="Center"
                               Foreground="{DynamicResource ArBrush.TextSecondary}" />
                  </StackPanel>
                </StackPanel>
              </Grid>

              <Grid Grid.Row="2" ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto" ColumnSpacing="9" RowSpacing="6"
                    VerticalAlignment="Center">
                <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                  <Border Width="27" Height="27" CornerRadius="8"
                          Background="{DynamicResource ArBrush.Surface3}">
                    <LucideIcon Kind="Mic" Size="14" StrokeWidth="1.8"
                                Foreground="{DynamicResource ArBrush.TextSecondary}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="Microphone" FontWeight="SemiBold"
                             FontSize="10.8" VerticalAlignment="Center" />
                  <ToggleSwitch x:Name="MicToggle" Grid.Column="2"
                                Classes="context-toggle ar-toggle"
                                Click="MicToggle_OnClick"
                                IsChecked="False" IsEnabled="False"
                                OnContent="" OffContent=""
                                ToolTip.Tip="Microphone recording is unavailable in this build." />
                </Grid>
                <ComboBox x:Name="MicrophoneDeviceComboMain"
                          Grid.Row="1" Grid.Column="0"
                          Classes="context-device" SelectedIndex="0" IsEnabled="False"
                          ToolTip.Tip="Microphone selection is unavailable in this build.">
                  <ComboBoxItem Content="No microphone detected" />
                </ComboBox>
                <StackPanel Grid.Column="1" Grid.RowSpan="2"
                            Orientation="Horizontal" Spacing="5"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip.Tip="Live input peak L/R (60 dB range).">
                  <StackPanel Spacing="3" HorizontalAlignment="Center">
                    <Border Width="8" Height="55" CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource ArBrush.Surface3}">
                      <Border x:Name="MicrophoneLevelL" Height="0" VerticalAlignment="Bottom"
                              CornerRadius="4" Background="{DynamicResource ArBrush.Success}" />
                    </Border>
                    <TextBlock Text="L" FontSize="9" HorizontalAlignment="Center"
                               Foreground="{DynamicResource ArBrush.TextSecondary}" />
                  </StackPanel>
                  <StackPanel Spacing="3" HorizontalAlignment="Center">
                    <Border Width="8" Height="55" CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource ArBrush.Surface3}">
                      <Border x:Name="MicrophoneLevelR" Height="0" VerticalAlignment="Bottom"
                              CornerRadius="4" Background="{DynamicResource ArBrush.Success}" />
                    </Border>
                    <TextBlock Text="R" FontSize="9" HorizontalAlignment="Center"
                               Foreground="{DynamicResource ArBrush.TextSecondary}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Column="2" Classes="context-card">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <LucideIcon Kind="Video" Size="14" StrokeWidth="1.8"
                              Foreground="{DynamicResource ArBrush.TextSecondary}" />
                  <TextBlock Text="Webcam" Classes="context-title" />
                </StackPanel>
                <ToggleSwitch x:Name="CameraToggle"
                              Grid.Column="1" Classes="context-toggle ar-toggle"
                              IsChecked="False" IsEnabled="False"
                              OnContent="" OffContent=""
                              ToolTip.Tip="Live webcam preview is unavailable until the camera backend is implemented." />
              </Grid>
              <!-- Honest 16:9 preview: a centered camera glyph while OFF or
                   backend unavailable, not a simulated image or fake feed. -->
              <Border x:Name="CameraPreviewFrame"
                      Grid.Row="1" Classes="camera-preview"
                      Width="148" Height="83.25"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      ToolTip.Tip="Webcam preview is unavailable in this build.">
                <Grid>
                  <Image x:Name="CameraPreviewImage" IsVisible="False"
                         Stretch="UniformToFill" />
                  <LucideIcon x:Name="CameraPreviewPlaceholder"
                              Kind="Camera" Size="26" StrokeWidth="1.5"
                              Foreground="{DynamicResource ArBrush.TextSecondary}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ComboBox x:Name="CameraDeviceComboMain" Grid.Row="2"
                        Classes="context-device" SelectedIndex="0" IsEnabled="False"
                        ToolTip.Tip="Camera selection will be available with the webcam backend.">
                <ComboBoxItem Content="No camera detected" />
              </ComboBox>
            </Grid>
          </Border>

          <Border Grid.Column="3" Classes="context-card">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="5">
              <Button x:Name="RecordButton"
                      Classes="record-circle"
                      Click="Record_OnClick"
                      AutomationProperties.Name="Start recording">
                <LucideIcon x:Name="RecordIcon"
                            Kind="Circle"
                            Size="24"
                            StrokeWidth="2.2"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
              </Button>
              <TextBlock x:Name="RecordText"
                         Text="Start"
                         FontSize="11.5"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <Border Classes="hotkey-chip" HorizontalAlignment="Center">
                <TextBlock x:Name="RecordHotkeyText"
                           Text="F9"
                           FontSize="10"
                           FontWeight="SemiBold"
                           FontFeatures="+tnum"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Grid IsVisible="False">
          <Button x:Name="MicDeviceButton"><TextBlock x:Name="MicDeviceText" /></Button>
          <LucideIcon x:Name="MicDeviceChevron" Kind="ChevronDown" />
          <Button x:Name="MicOptionCable" />
          <Button x:Name="MicOptionArray" />
          <Button x:Name="MicOptionLong" />
          <Button x:Name="CameraDeviceButton"><TextBlock x:Name="CameraDeviceText" /></Button>
          <LucideIcon x:Name="CameraDeviceChevron" Kind="ChevronDown" />
          <Button x:Name="CameraOptionUsb" />
          <Button x:Name="CameraOptionObs" />
          <Button x:Name="CameraOptionLong" />
        </Grid>

        <!-- Status + primary transport -->
        <Border
            Grid.Row="1"
            Padding="11,8"
            Background="{DynamicResource ArBrush.Surface1Overlay}"
            BorderBrush="{DynamicResource ArBrush.Stroke}"
            BorderThickness="1"
            CornerRadius="10"
            VerticalAlignment="Bottom">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
              <Ellipse
                  x:Name="StatusDot"
                  Width="7"
                  Height="7"
                  Fill="{DynamicResource ArBrush.Success}" />
              <TextBlock
                  x:Name="StatusText"
                  Text="Ready"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource ArBrush.Success}"
                  VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock
                x:Name="StatusDetail"
                Grid.Column="1"
                Text=""
                Classes="micro"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                x:Name="SavedActions"
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="6"
                IsVisible="False"
                VerticalAlignment="Center">
              <Button Classes="saved-action" Click="OpenSaved_OnClick"
                      AutomationProperties.Name="Open saved recording">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <LucideIcon Kind="ExternalLink" Size="13" StrokeWidth="1.8"
                              VerticalAlignment="Center"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock Text="Open" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="saved-action" Click="ShowFolder_OnClick"
                      AutomationProperties.Name="Show saved recording in folder">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <LucideIcon Kind="FolderOpen" Size="13" StrokeWidth="1.8"
                              VerticalAlignment="Center"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock Text="Folder" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>


          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
