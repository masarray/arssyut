<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Base typography -->
  <Style Selector="Window">
    <Setter Property="TextElement.FontFamily" Value="{DynamicResource ArFont.Inter}" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource ArType.Body}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ArBrush.Text}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource ArFont.Inter}" />
    <Setter Property="FontSize" Value="{DynamicResource ArType.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
  </Style>

  <Style Selector="TextBlock.micro">
    <Setter Property="FontSize" Value="{DynamicResource ArType.Micro}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.TextDim}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.TextSecondary}" />
  </Style>

  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{DynamicResource ArType.Section}" />
    <Setter Property="FontWeight" Value="{DynamicResource ArWeight.SemiBold}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource ArType.Title}" />
    <Setter Property="FontWeight" Value="{DynamicResource ArWeight.SemiBold}" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource ArBrush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArRadius.LG}" />
  </Style>

  <Style Selector="Border.subtle-panel">
    <Setter Property="Background" Value="#8F161B23" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArRadius.MD}" />
  </Style>

  <!-- Product buttons -->
  <Style Selector="Button.ar">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="{DynamicResource ArControl.SM}" />
    <Setter Property="Padding" Value="{DynamicResource ArPadding.Button}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArRadius.MD}" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArFont.Inter}" />
    <Setter Property="FontSize" Value="{DynamicResource ArType.Control}" />
    <Setter Property="FontWeight" Value="{DynamicResource ArWeight.Medium}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.ar:pointerover">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.StrokeStrong}" />
  </Style>

  <Style Selector="Button.ar:pressed">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfacePressed}" />
  </Style>

  <Style Selector="Button.ar:disabled">
    <Setter Property="Opacity" Value="0.42" />
  </Style>

  <Style Selector="Button.ar:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Record}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.segment">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinWidth" Value="92" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.TextSecondary}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArFont.Inter}" />
    <Setter Property="FontSize" Value="{DynamicResource ArType.Control}" />
    <Setter Property="FontWeight" Value="{DynamicResource ArWeight.Medium}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.segment:pointerover">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
  </Style>

  <Style Selector="Button.segment:pressed">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfacePressed}" />
  </Style>

  <Style Selector="Button.segment.selected">
    <Setter Property="Background" Value="{DynamicResource ArBrush.Selection}" />
    <Setter Property="BorderBrush" Value="#78FF5864" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
  </Style>

  <Style Selector="Button.segment.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SelectionHover}" />
  </Style>

  <Style Selector="Button.segment.selected:pressed">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SelectionPressed}" />
  </Style>

  <Style Selector="Button.segment:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Record}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="{DynamicResource ArControl.SM}" />
    <Setter Property="MinWidth" Value="{DynamicResource ArControl.SM}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button.window-control">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.TextSecondary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.window-control:pointerover">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
  </Style>

  <Style Selector="Button.window-control.danger:pointerover">
    <Setter Property="Background" Value="#C93A424D" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.record">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="{DynamicResource ArControl.Record}" />
    <Setter Property="MinWidth" Value="116" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Record}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Record}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontFamily" Value="{DynamicResource ArFont.Inter}" />
    <Setter Property="FontSize" Value="{DynamicResource ArType.Section}" />
    <Setter Property="FontWeight" Value="{DynamicResource ArWeight.SemiBold}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.record:pointerover">
    <Setter Property="Background" Value="{DynamicResource ArBrush.RecordHover}" />
  </Style>

  <Style Selector="Button.record:pressed">
    <Setter Property="Background" Value="{DynamicResource ArBrush.RecordPressed}" />
  </Style>

  <Style Selector="Button.record:focus-visible">
    <Setter Property="BorderBrush" Value="White" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.TextSecondary}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArFont.Inter}" />
    <Setter Property="FontSize" Value="{DynamicResource ArType.Control}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.settings-nav">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="14,0" />
  </Style>

  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
  </Style>

  <Style Selector="Button.nav:pressed">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfacePressed}" />
  </Style>

  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="{DynamicResource ArBrush.Selection}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
  </Style>

  <Style Selector="Button.nav.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SelectionHover}" />
  </Style>

  <Style Selector="Button.source-picker">
    <Setter Property="Height" Value="48" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="#B512171E" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.source-picker:pointerover">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.StrokeStrong}" />
  </Style>

  <Style Selector="Button.source-picker:pressed">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfacePressed}" />
  </Style>

  <Style Selector="Border.hotkey-chip">
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Surface3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.StrokeStrong}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Device selectors and flyouts -->
  <Style Selector="Button.device-picker">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="54" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArRadius.LG}" />
    <Setter Property="Background" Value="#B0161B23" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArFont.Inter}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.device-picker:pointerover">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.StrokeStrong}" />
  </Style>

  <Style Selector="Button.device-picker:pressed">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfacePressed}" />
  </Style>

  <Style Selector="Button.device-picker:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Record}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.device-option">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.device-option:pointerover">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfaceHover}" />
  </Style>

  <Style Selector="Button.device-option.selected">
    <Setter Property="Background" Value="{DynamicResource ArBrush.RecordSoft}" />
    <Setter Property="BorderBrush" Value="#52FF4D57" />
  </Style>

  <Style Selector="Button.device-option:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Record}" />
  </Style>

  <Style Selector="FlyoutPresenter.device-flyout">
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="#FC161B23" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.StrokeStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>

  <Style Selector="Button.saved-action">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.TextSecondary}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.saved-action:pointerover">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
  </Style>

  <Style Selector="Button.saved-action:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Record}" />
  </Style>

  <!-- Inputs -->
  <Style Selector="ComboBox.ar-select">
    <Setter Property="Height" Value="{DynamicResource ArControl.SM}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="{DynamicResource ArControl.SM}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArFont.Inter}" />
    <Setter Property="FontSize" Value="{DynamicResource ArType.Control}" />
  </Style>

  <Style Selector="ComboBox.ar-select:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.StrokeStrong}" />
  </Style>

  <Style Selector="ComboBox.ar-select:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Record}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="ToggleSwitch.ar-toggle">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource ArFont.Inter}" />
    <Setter Property="FontSize" Value="{DynamicResource ArType.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="ToggleSwitch.ar-toggle:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Record}" />
  </Style>

  <Style Selector="TextBox.ar-input">
    <Setter Property="Height" Value="{DynamicResource ArControl.SM}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArRadius.MD}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArFont.Inter}" />
  </Style>

  <Style Selector="Border.device">
    <Setter Property="MinHeight" Value="70" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="#B0161B23" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArRadius.LG}" />
  </Style>

  <Style Selector="Border.setting-row">
    <Setter Property="Padding" Value="0,12" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.setting-row TextBlock.micro">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.capability-lock">
    <Setter Property="Padding" Value="14" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArRadius.LG}" />
  </Style>

  <Style Selector="Border.context-card">
    <Setter Property="Padding" Value="12" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="TextBlock.context-title">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.TextDim}" />
  </Style>

  <Style Selector="Button.record-circle">
    <Setter Property="Width" Value="66" />
    <Setter Property="Height" Value="66" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="33" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Record}" />
    <Setter Property="BorderBrush" Value="#72FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.record-circle:pointerover">
    <Setter Property="Background" Value="#FFFF6671" />
  </Style>

  <Style Selector="Button.record-circle:pressed">
    <Setter Property="Background" Value="#FFE94855" />
  </Style>

  <Style Selector="Button.record-circle:disabled">
    <Setter Property="Opacity" Value="0.42" />
  </Style>

  <!-- Settings product controls -->
  <Style Selector="Border.value-pill">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <Style Selector="Button.hotkey">
    <Setter Property="Width" Value="132" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Surface3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.StrokeStrong}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArFont.Inter}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.hotkey:pointerover">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.StrokeStrong}" />
  </Style>

  <Style Selector="Button.hotkey.capturing">
    <Setter Property="Background" Value="{DynamicResource ArBrush.RecordSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Record}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Record}" />
  </Style>

  <Style Selector="Button.hotkey:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Record}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.hotkey:disabled">
    <Setter Property="Opacity" Value="0.68" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Surface3}" />
  </Style>

  <Style Selector="ToggleButton.capture-mode">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.TextSecondary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.10" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.10" />
        <BrushTransition Property="Foreground" Duration="0:0:0.10" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ToggleButton.capture-mode:pointerover">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.StrokeStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
  </Style>

  <Style Selector="ToggleButton.capture-mode:checked">
    <Setter Property="Background" Value="{DynamicResource ArBrush.RecordSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Record}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
  </Style>

  <Style Selector="ToggleButton.capture-mode:pressed">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfacePressed}" />
  </Style>

  <Style Selector="ToggleButton.capture-mode:disabled">
    <Setter Property="Opacity" Value="0.46" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="ComboBox.context-device">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="ComboBox.context-device:disabled">
    <Setter Property="Opacity" Value="0.74" />
  </Style>

  <Style Selector="ToggleSwitch.context-toggle">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ToggleSwitch.context-toggle:disabled">
    <Setter Property="Opacity" Value="0.72" />
  </Style>

  <Style Selector="Button.camera-anchor">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.TextSecondary}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.camera-anchor:pointerover">
    <Setter Property="Background" Value="{DynamicResource ArBrush.SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Text}" />
  </Style>

  <Style Selector="Button.camera-anchor.selected">
    <Setter Property="Background" Value="{DynamicResource ArBrush.RecordSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Record}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Record}" />
  </Style>

  <Style Selector="Button.camera-anchor:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.Record}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="ProgressBar.audio-meter">
    <Setter Property="Width" Value="182" />
    <Setter Property="Height" Value="5" />
    <Setter Property="MinHeight" Value="5" />
    <Setter Property="Background" Value="{DynamicResource ArBrush.Surface3}" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.Success}" />
  </Style>

  <Style Selector="Border.camera-preview">
    <Setter Property="Width" Value="214" />
    <Setter Property="Height" Value="120" />
    <Setter Property="Background" Value="#FF0E1217" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArBrush.StrokeStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="TextBlock.path-preview">
    <Setter Property="MaxWidth" Value="300" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{DynamicResource ArBrush.TextSecondary}" />
  </Style>

</Styles>
